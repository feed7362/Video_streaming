#: errors/comments.py:10
msgid "Comment not found"
msgstr "Коментар не знайдено"

#: errors/comments.py:18
msgid "Parent comment not found"
msgstr "Батьківський коментар не знайдено"

#: errors/comments.py:26
msgid "Not allowed to delete this comment"
msgstr "Видалення цього коментаря заборонено"

#: errors/comments.py:34
msgid "Parent comment belongs to a different video"
msgstr "Батьківський коментар належить до іншого відео"

#: errors/files.py:10
msgid "Invalid file path format"
msgstr "Невірний формат шляху до файлу"

#: errors/files.py:18
msgid "File not found in storage"
msgstr "Файл не знайдено у сховищі"

#: errors/files.py:26
msgid "Failed to generate signed URL"
msgstr "Не вдалося згенерувати підписаний URL"

#: errors/files.py:34
msgid "Failed to delete files from storage"
msgstr "Не вдалося видалити файли зі сховища"

#: errors/files.py:43
#, python-format
msgid "Video resolution '%(res)s' not found"
msgstr "Роздільну здатність відео '%(res)s' не знайдено"

#: errors/files.py:53
#, python-format
msgid "Failed to download file '%(key)s' from storage"
msgstr "Не вдалося завантажити файл '%(key)s' зі сховища"

#: errors/files.py:62
msgid "Invalid video format"
msgstr "Невірний формат відео"

#: errors/files.py:70
msgid "Invalid thumbnail format"
msgstr "Невірний формат мініатюри"

#: errors/files.py:78
msgid "User does not have a channel"
msgstr "Користувач не має каналу"

#: errors/files.py:86
msgid "Failed to upload video to storage"
msgstr "Не вдалося завантажити відео до сховища"

#: errors/files.py:94
msgid "Video with the same hash already exists"
msgstr "Відео з таким самим хешем уже існує"

#: errors/files.py:102
msgid "Failed to publish encoding job"
msgstr "Не вдалося опублікувати завдання кодування"

#: errors/files.py:111
#, python-format
msgid "The uploaded file exceeds the maximum allowed size of %(size)sMB"
msgstr "Завантажений файл перевищує максимально дозволений розмір %(size)s МБ"

#: errors/files.py:121
msgid "The uploaded file is empty"
msgstr "Завантажений файл порожній"

#: errors/health.py:10
msgid "Database is unavailable"
msgstr "База даних недоступна"

#: errors/health.py:18
msgid "Object storage is not reachable"
msgstr "Сховище об'єктів недоступне"

#: errors/health.py:26
msgid "Message broker is not reachable"
msgstr "Брокер повідомлень недоступний"

#: errors/rabbit_broker.py:10
#, python-format
msgid "Unknown encoder status: '%(status)s'"
msgstr "Невідомий статус кодувальника: '%(status)s'"

#: errors/rabbit_broker.py:18
msgid "Failed to persist video encoding results"
msgstr "Не вдалося зберегти результати кодування відео"

#: errors/rabbit_broker.py:26
msgid "Failed to insert resolutions"
msgstr "Не вдалося додати роздільні здатності"

#: errors/reactions.py:11
#, python-format
msgid "Unknown reaction type '%(reaction_name)s'"
msgstr "Невідомий тип реакції '%(reaction_name)s'"

#: errors/search.py:10
#, python-format
msgid "Failed to perform search for query: '%(query)s'"
msgstr "Не вдалося виконати пошук для запиту: '%(query)s'"

#: errors/search.py:21
#, python-format
msgid "Failed to perform search hints for query: '%(query)s'"
msgstr "Не вдалося виконати підказки пошуку для запиту: '%(query)s'"

#: errors/videos.py:10
msgid "Video not found or not owned by the user"
msgstr "Відео не знайдено або воно не належить користувачу"

#: errors/videos.py:18
msgid "You do not own this video"
msgstr "Ви не є власником цього відео"

#: errors/videos.py:26
msgid "Failed to record video view"
msgstr "Не вдалося зафіксувати перегляд відео"

#: errors/videos.py:35
#, python-format
msgid "Invalid privacy level: %(level)s"
msgstr "Невірний рівень приватності: %(level)s"
